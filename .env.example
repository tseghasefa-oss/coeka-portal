# COEKA Portal — Environment Variables Template
# Copy this to .env and fill in your real values.
# The .env file is gitignored — never commit it.

# ─── Sentry (Frontend) ────────────────────────────────────────────────────────
# Get from: https://sentry.io → Your Project → Settings → Client Keys (DSN)
# Prefix VITE_ is required for Vite to expose it to the browser bundle.
VITE_SENTRY_DSN=https://YOUR_KEY@o0.ingest.sentry.io/YOUR_PROJECT_ID

# Build mode (automatically set by Vite: 'development' or 'production')
# Do not set this manually.
# MODE=production
